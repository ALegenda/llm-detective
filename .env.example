OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
APP_ENV=development
APP_ORIGIN=http://localhost:8080
DATA_DIR=data
WORKERS=2
CASE_CALL_LIMIT=140
DAILY_CALL_LIMIT=500
ADMIN_EMAILS=tomkouper@gmail.com
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_ADMIN_IDS=

# Commands have an independent budget, so art cannot consume all gameplay calls.
ATTEMPT_CALL_LIMIT=200

# Story construction and consistency audits use a separate reasoning model.
OPENAI_STORY_MODEL=gpt-6-luna
OPENAI_STORY_REASONING=medium
OPENAI_TEXT_REASONING=none
OPENAI_DIALOGUE_REASONING=low
