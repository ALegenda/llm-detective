OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_COMPRESSION=80
OPENAI_IMAGE_SQUARE_SIZE=832x832
OPENAI_IMAGE_LANDSCAPE_SIZE=1152x768
APP_ENV=development
APP_ORIGIN=http://localhost:8080
DATA_DIR=data
WORKERS=2
CASE_CALL_LIMIT=140
DAILY_CALL_LIMIT=500
ADMIN_EMAILS=tomkouper@gmail.com
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_ADMIN_IDS=

# Commands have an independent budget, so art cannot consume all gameplay calls.
ATTEMPT_CALL_LIMIT=200

# Story construction and consistency audits use a separate reasoning model.
OPENAI_STORY_MODEL=gpt-6-luna
OPENAI_STORY_REASONING=medium
OPENAI_TEXT_REASONING=none
OPENAI_DIALOGUE_REASONING=low

# Private image storage. SQLite continues to use DATA_DIR.
ASSET_STORAGE=local
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Explicit, resumable migration: upload + SHA-256 readback, then remove local PNGs.
# Keep ASSET_STORAGE=r2 after migration; local copies no longer exist.
R2_MIGRATE_LOCAL=0
# Application cap for this dedicated bucket, not an account-wide billing limit.
R2_MAX_BYTES=9000000000
